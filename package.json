{
  "name": "haiku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Haiku — gestionnaire de mots de passe hors ligne (fonctions de Bitwarden et de Keyra), animations GSAP, interface modulaire, empaqueté en APK avec Capacitor",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "sync": "vite build && cap sync android && node scripts/patch-android.mjs",
    "open": "cap open android",
    "android": "npm run sync && cap open android",
    "icons": "npx @capacitor/assets generate --android --iconBackgroundColor #07050d --iconBackgroundColorDark #07050d --splashBackgroundColor #07050d --splashBackgroundColorDark #07050d"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "gsap": "^3.15.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^6.4.4"
  }
}
